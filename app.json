{
  "expo": {
    "name": "Reclaim",
    "slug": "reclaim-v2",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "reclaim",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.reclaim.mobile"
    },
    "android": {
      "package": "app.reclaim.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.reclaim.mobile.widgets",
          "groupIdentifier": "group.app.reclaim.mobile",
          "widgets": [
            {
              "name": "ReclaimGlance",
              "displayName": "Reclaim",
              "description": "See your Reclaim journey at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
