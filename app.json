{
  "expo": {
    "name": "Reclaim",
    "slug": "reclaim-v2",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "reclaim",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.reclaim.mobile"
    },
    "android": {
      "package": "app.reclaim.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-splash-screen", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
