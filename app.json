{
  "expo": {
    "name": "Reclaim",
    "slug": "reclaim-v2",
    "owner": "sankalpvoid",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "reclaim",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.reclaim.mobile",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(CFBundleIdentifier)"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "package": "app.reclaim.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "monochromeImage": "./assets/branding/monochrome-icon.png",
        "backgroundColor": "#0A0A0F"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/approved-icon-master.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0F"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.reclaim.mobile.widgets",
          "groupIdentifier": "group.app.reclaim.mobile",
          "widgets": [
            {
              "name": "ReclaimGlance",
              "displayName": "Reclaim",
              "description": "See your Reclaim journey at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "35a0891e-f3e8-4092-9cc3-75fd929a635f"
      }
    },
    "icon": "./assets/branding/icon.png"
  }
}
